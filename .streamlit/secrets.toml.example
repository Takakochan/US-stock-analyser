# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml and add your actual API key

# OpenAI API Key (required for AI competitor analysis)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-your-api-key-here"

# Instructions:
# 1. Copy this file: cp secrets.toml.example secrets.toml
# 2. Replace "sk-your-api-key-here" with your actual OpenAI API key
# 3. Never commit secrets.toml to version control (it's in .gitignore)
